# Copie este arquivo para ".env" ao rodar localmente (o Railway injeta essas variáveis
# automaticamente em produção quando você conecta o plugin do Postgres — não precisa
# criar o .env lá).

# Injetada automaticamente pelo plugin Postgres do Railway. Localmente, aponte para
# um Postgres seu, ex: postgres://usuario:senha@localhost:5432/onevision
DATABASE_URL=

# String aleatória qualquer, usada para assinar o cookie de sessão.
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Opcionais — só preencha depois de criar credenciais OAuth no Google Cloud Console.
# Enquanto vazias, o login com Google usa um seletor de contas simulado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Porta local (o Railway injeta a dele automaticamente, não precisa mexer em produção).
PORT=3000
