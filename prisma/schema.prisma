// One OS — Onevision1ture
// Banco: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── ACESSO & HIERARQUIA ───────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  avatarUrl    String?
  phone        String?
  jobTitle     String?
  bio          String?
  locale       String    @default("pt")
  theme        String    @default("dark")
  isActive     Boolean   @default(true)
  isFounder    Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  ownedClients  Client[]      @relation("ClientOwner")
  assignedLeads Lead[]        @relation("LeadOwner")
  payrolls      Payroll[]
  activities    ActivityLog[]
  uploadedFiles FileNode[]    @relation("FileUploader")
  contracts     Contract[]    @relation("ContractOwner")
  tasks         LeadTask[]    @relation("TaskAssignee")
  notes         LeadNote[]
  boards        Board[]       @relation("BoardOwner")
  cards         Card[]        @relation("CardAssignee")
  cardComments  CardComment[] @relation("CommentAuthor")

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#E11D2E")
  level       Int      @default(10)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  page      Page    @default(INICIO)
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, page])
  @@index([roleId])
}

enum Page {
  INICIO
  CLIENTES
  CRM
  TAREFAS
  EQUIPE
  FINANCEIRO
  CONTRATOS
  ARQUIVOS
  CONFIGURACOES
}

// ─────────────────────────── CLIENTES ───────────────────────────

model Client {
  id      String       @id @default(cuid())
  name    String
  company String?
  cnpj    String?
  email   String?
  phone   String?
  website String?
  segment String?
  city    String?
  state   String?
  logoUrl String?
  status  ClientStatus @default(ATIVO)

  monthlyBudget Decimal   @default(0) @db.Decimal(12, 2)
  monthlyFee    Decimal   @default(0) @db.Decimal(12, 2)
  contractStart DateTime?
  contractEnd   DateTime?
  notes         String?

  services  ClientService[]
  contracts Contract[]
  invoices  Invoice[]
  files     FileNode[]
  leads     Lead[]

  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
}

enum ClientStatus {
  ATIVO
  PAUSADO
  ENCERRADO
  PROSPECCAO
}

model ClientService {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service
  value    Decimal @default(0) @db.Decimal(12, 2)

  @@unique([clientId, service])
  @@index([clientId])
}

enum Service {
  TRAFEGO_PAGO
  CONSULTORIA
  SISTEMAS
  SOCIAL_MEDIA
  SITE_LP
  VIDEO
  BRANDING
}

// ─────────────────────────── CRM ───────────────────────────

model PipelineStage {
  id       String  @id @default(cuid())
  name     String
  color    String  @default("#E11D2E")
  position Int
  isWon    Boolean @default(false)
  isLost   Boolean @default(false)

  leads Lead[]

  @@index([position])
}

model Lead {
  id      String     @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?
  source  LeadSource @default(OUTRO)

  estimatedValue  Decimal     @default(0) @db.Decimal(12, 2)
  temperature     Temperature @default(MORNO)
  position        Int         @default(0)
  expectedCloseAt DateTime?
  lostReason      String?

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  notes LeadNote[]
  tasks LeadTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, position])
  @@index([ownerId])
}

enum LeadSource {
  INDICACAO
  INSTAGRAM
  GOOGLE
  SITE
  PROSPECCAO_ATIVA
  EVENTO
  OUTRO
}

enum Temperature {
  FRIO
  MORNO
  QUENTE
}

model LeadNote {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadTask {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  title String
  done  Boolean   @default(false)
  dueAt DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
}

// ─────────────────────────── FINANCEIRO ───────────────────────────

model Payroll {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(12, 2)
  kind     PayKind @default(SALARIO)
  dueDay   Int     @default(5)
  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum PayKind {
  SALARIO
  PRO_LABORE
  FREELA
  COMISSAO
  BONUS
}

model Tool {
  id       String       @id @default(cuid())
  name     String
  category String?
  cost     Decimal      @db.Decimal(12, 2)
  cycle    BillingCycle @default(MENSAL)
  renewsAt DateTime?
  isActive Boolean      @default(true)
  url      String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BillingCycle {
  MENSAL
  ANUAL
  UNICO
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  type        TxType
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
}

enum TxType {
  ENTRADA
  SAIDA
}

model Invoice {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(12, 2)
  dueAt     DateTime
  paidAt    DateTime?
  status    InvoiceStatus @default(PENDENTE)
  reference String?
  createdAt DateTime      @default(now())

  @@index([clientId])
  @@index([status])
}

enum InvoiceStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

// ─────────────────────────── CONTRATOS ───────────────────────────

model Contract {
  id       String  @id @default(cuid())
  title    String
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  value   Decimal        @default(0) @db.Decimal(12, 2)
  startAt DateTime?
  endAt   DateTime?
  status  ContractStatus @default(ATIVO)
  fileUrl String?
  notes   String?

  ownerId String?
  owner   User?   @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

enum ContractStatus {
  ATIVO
  RENOVACAO
  ENCERRADO
  RASCUNHO
}

// ─────────────────────────── ARQUIVOS ───────────────────────────

model FileNode {
  id       String   @id @default(cuid())
  name     String
  kind     NodeKind @default(FOLDER)
  mimeType String?
  size     Int?
  url      String?
  position Int      @default(0)

  parentId String?
  parent   FileNode?  @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileNode[] @relation("FileTree")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  uploaderId String?
  uploader   User?   @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

enum NodeKind {
  FOLDER
  FILE
}

// ─────────────────────────── AUDITORIA ───────────────────────────

model ActivityLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String?
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── TAREFAS (quadros) ───────────────────────────

model Board {
  id          String  @id @default(cuid())
  name        String
  icon        String  @default("📋")
  color       String  @default("#E11D2E")
  bannerUrl   String?
  background  String? // imagem de fundo do quadro
  description String?
  position    Int     @default(0)
  isArchived  Boolean @default(false)

  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  columns BoardColumn[]
  labels  BoardLabel[]
  cards   Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, position])
}

model BoardColumn {
  id       String @id @default(cuid())
  name     String
  color    String @default("#64748B")
  position Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, position])
}

model BoardLabel {
  id    String @id @default(cuid())
  name  String
  color String @default("#E11D2E")

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards CardLabel[]

  @@index([boardId])
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  position    Int       @default(0)
  dueAt       DateTime?
  startAt     DateTime?
  coverColor  String?
  coverUrl    String?
  isDone      Boolean   @default(false)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId String
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  labels    CardLabel[]
  checklist CardCheckItem[]
  comments  CardComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId, position])
  @@index([boardId])
}

model CardLabel {
  cardId  String
  card    Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   BoardLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardCheckItem {
  id       String  @id @default(cuid())
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
}

model CardComment {
  id   String @id @default(cuid())
  body String

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([cardId])
}
